# Copy to .env and fill locally. Never commit .env.
BRAIN_EMAIL=
BRAIN_PASSWORD=
BRAIN_API_URL=https://api.worldquantbrain.com
BRAIN_SUPPORT_URL=https://support.worldquantbrain.com
BRAIN_FORUM_LOCALE=en-us
BRAIN_FORUM_ARTIFACT_DIR=.forum-runs
# Default: version-matched Playwright bundled Chromium (run `uv run python scripts/install_browser.py`).
# Set to auto only to explicitly permit a system Chrome fallback.
BRAIN_FORUM_CHROME_CHANNEL=chromium
# Set false only when the Support editor blocks headless automation.
BRAIN_FORUM_HEADLESS=true
# Repository-isolated cache avoids stale or locked global Playwright revisions.
BRAIN_FORUM_PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers

# Optional reusable AI_ONLY probe. Do not commit personal values.
BRAIN_FORUM_PROBE_POST_ID=
BRAIN_FORUM_PROBE_POST_URL=
